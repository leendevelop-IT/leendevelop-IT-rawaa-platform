# Optional: actual Sentinel-2 NDVI/NDMI statistics from Copernicus Data Space.
# Create an OAuth client in the Copernicus Data Space Sentinel Hub dashboard.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Cookie 'Secure' flag: set 1 on HTTPS hosting (Render), keep 0 for http://localhost
RAWAA_SECURE_COOKIE=0
# Optional: database path; defaults to project data/rawaa.sqlite3
RAWAA_DB=

# Optional: persistent PostgreSQL (e.g. Neon). Leave empty to use local SQLite.
DATABASE_URL=

# --- Intelligence layer (decision / forecast / schedule) ---
# Run the analysis + scheduling pipeline automatically inside the web process (idempotent; safe across restarts).
RAWAA_AUTO_PIPELINE=0
# Hours between automatic runs when RAWAA_AUTO_PIPELINE=1
RAWAA_PIPELINE_HOURS=12
# Log level: DEBUG, INFO, WARNING
RAWAA_LOG_LEVEL=INFO

# Demo role switcher (regulator <-> operator without password, for the demo accounts only).
# Set RAWAA_ENV=production to turn it off for real use.
# RAWAA_ENV=production
